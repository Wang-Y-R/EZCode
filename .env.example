# 复制本文件为 .env 并填入你的真实 key。.env 不要提交到 git。

# Anthropic API Key（必填）：https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxx

# 模型 ID（必填）
MODEL_ID=claude-sonnet-4-6

# 可选：使用第三方 Anthropic 兼容端点时，取消注释并填网关地址，
# 同时把 MODEL_ID 改成该网关对应的模型名。
# ANTHROPIC_BASE_URL=https://api.anthropic.com

EZCODE_PERMISSION_MODE=auto